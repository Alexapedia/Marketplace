# Production settings. Copy to deploy/.env (never commit it) and fill in.
# Used by docker-compose.prod.yml and passed to the api container.

# ---- Hosts -------------------------------------------------------------------
# API host the mobile apps call (their API_URL is https://<API_HOST>/api/v1).
API_HOST=api.yourplatform.com
# Platform only: makes unknown store domains a 404 instead of the default store.
# Set it to API_HOST. Leave EMPTY for a single-store (buyer) install, so every
# host serves that one store.
API_HOSTS=api.yourplatform.com
# Platform only: the holder's host.
HOLDER_HOST=holder.yourplatform.com

# ---- Database ----------------------------------------------------------------
# Letters and digits only in the password (it goes into a connection URL).
MONGO_USER=placemarket
MONGO_PASSWORD=change-me-long-random

# ---- Security ----------------------------------------------------------------
# Long random values, different from each other (e.g. openssl rand -hex 32).
JWT_SECRET=change-me
JWT_PLATFORM_SECRET=change-me-too
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
# Same-origin through the proxy, so no cross-origin browser access is needed.
CORS_ORIGINS=
# Default trusts the proxy containers only; correct with this stack.
# TRUST_PROXY=

# ---- First accounts (created once on an empty database) ----------------------
# Public default passwords are refused in production and the account is skipped.
SEED_ADMIN_EMAIL=admin@yourstore.com
SEED_ADMIN_PASSWORD=change-me-strong
SEED_HOLDER_EMAIL=you@yourplatform.com
SEED_HOLDER_PASSWORD=change-me-strong
# The store created on first boot. A buyer: their store's slug.
DEFAULT_TENANT_SLUG=zezo
# Demo products and banners on first boot (off in production by default).
# SEED_DEMO=false

# ---- Email (password reset) --------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourplatform.com

# ---- Firebase (push, crash reports) ------------------------------------------
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Local testing only -------------------------------------------------------
# HTTP_PORT=8080
# HTTPS_PORT=8443
