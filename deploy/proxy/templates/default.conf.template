# Front proxy: one TLS endpoint that sends every host to its container.
# ${API_HOST} and ${HOLDER_HOST} come from deploy/.env (envsubst at start).

include /etc/nginx/cloudflare-realip.conf;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Which container serves a host. Exact names win over the patterns below, so
# a client with its own frontend (clients/*.map) beats the shared one.
map $host $upstream {
  hostnames;
  default         web:80;
  ${API_HOST}     api:3000;
  ${HOLDER_HOST}  holder:80;
  ~-admin\.       admin:80;
  ~^admin\.       admin:80;
  include /etc/nginx/clients/*.map;
}

server {
  listen 80 default_server;
  server_name _;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name _;

  ssl_certificate     /etc/nginx/certs/origin.pem;
  ssl_certificate_key /etc/nginx/certs/origin.key;

  # The API accepts uploads up to 8 MB.
  client_max_body_size 10m;

  location / {
    # Docker DNS, resolved per request so a stopped or optional container
    # (holder, a client's frontend) does not stop the proxy from starting.
    resolver 127.0.0.11 valid=10s ipv6=off;
    proxy_pass http://$upstream;
    proxy_http_version 1.1;
    # The API picks the store from the Host, so keep the original one.
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Real client IP (restored from Cloudflare above); replaces any value the
    # client sent, so it cannot be spoofed.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }
}
