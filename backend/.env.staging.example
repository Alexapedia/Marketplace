PORT=3000
NODE_ENV=staging
MONGODB_URI=mongodb://mongo:27017/placemarket
JWT_SECRET=replace-with-a-long-random-staging-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
JWT_PLATFORM_SECRET=replace-with-a-long-random-platform-secret
CORS_ORIGINS=*
PUBLIC_URL=http://localhost:3010
DEFAULT_TENANT_SLUG=zezo
SEED_HOLDER_EMAIL=holder@placemarket.com
SEED_HOLDER_PASSWORD=Holder@123456
SEED_ADMIN_EMAIL=admin@placemarket.com
SEED_ADMIN_PASSWORD=Admin@123456
UPLOAD_DIR=./uploads
FIREBASE_ENABLED=false
# Password-reset email (logged to console when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
# Optional: override the storefront URL used in reset links (defaults to the tenant's website domain)
WEB_URL=
