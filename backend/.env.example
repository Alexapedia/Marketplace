PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/placemarket
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4300,http://127.0.0.1:4300
PUBLIC_URL=http://localhost:3000
DEFAULT_TENANT_SLUG=zezo
# Production: hosts that serve only the API (the mobile apps' API_URL), comma
# separated. When set, any other host that matches no store gets 404 instead
# of the default store. Leave empty in development.
# API_HOSTS=api.yourplatform.com
JWT_PLATFORM_SECRET=change-me-platform
SEED_HOLDER_EMAIL=holder@placemarket.com
SEED_HOLDER_PASSWORD=Holder@123456
UPLOAD_DIR=./uploads
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=./serviceAccount.json
SEED_ADMIN_EMAIL=admin@placemarket.com
SEED_ADMIN_PASSWORD=Admin@123456

# Proxy hops to trust for client IPs (rate limiting). Default trusts private
# networks only (nginx/cloudflared on the same host or docker network).
# TRUST_PROXY=loopback, linklocal, uniquelocal
